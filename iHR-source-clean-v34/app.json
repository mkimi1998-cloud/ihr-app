{
  "expo": {
    "name": "iHR",
    "slug": "ihr",
    "owner": "kimkuis-team",
    "version": "1.1.0",
    "runtimeVersion": "1.1.0",
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/f42a4a59-a4d5-4726-833f-5d343e669871"
    },
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "android": {
      "package": "my.gov.mtib.ihr",
      "versionCode": 9,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "plugins": [
      "expo-updates",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow iHR to access the camera for QR scanning and attendance photos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow iHR to use your location for geotagging attendance."
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#BC4A32"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Benarkan iHR mengakses galeri untuk memuat naik kod QR."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f42a4a59-a4d5-4726-833f-5d343e669871"
      }
    },
    "scheme": "ihr2"
  }
}
